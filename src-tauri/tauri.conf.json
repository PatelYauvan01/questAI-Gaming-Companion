{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuestAI",
  "version": "0.1.0",
  "identifier": "com.patel.questai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuestAI",
        "width": 1280,
        "height": 760,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "maximized": false
      },
      {
        "label": "guide-overlay",
        "title": "QuestAI Guide",
        "url": "index.html?overlay=1",
        "width": 440,
        "height": 620,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
